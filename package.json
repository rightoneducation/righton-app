{
  "name": "righton-monorepo-root",
  "private": true,
  "workspaces": [
    "play",
    "host_v2",
    "networking",
    "central_v2"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.14.0 <23",
    "yarn": "1.22.22"
  },
  "resolutions": {
    "@storybook/react-docgen-typescript-plugin": "1.0.6--canary.9.cd77847.0",
    "styled-components": "^5",
    "@mui/styled-engine": "npm:@mui/styled-engine-sc@latest",
    "@types/react": "~18.2.0",
    "@types/react-dom": "~18.2.0"
  },
  "scripts": {
    "check:install-location": "for w in central_v2 play host_v2 networking; do if [ -d $w/node_modules/react ]; then echo \"ERROR: yarn install was run inside $w, creating a duplicate React copy. Run yarn install from the repo root instead (see CONTRIBUTING.md), then delete $w/node_modules.\"; exit 1; fi; done",
    "check:deps": "manypkg check && syncpack lint",
    "verify": "yarn check:install-location && yarn check:deps",
    "postinstall": "yarn check:install-location"
  },
  "devDependencies": {
    "@manypkg/cli": "^0.25.1",
    "syncpack": "^15.3.2"
  },
  "manypkg": {
    "defaultBranch": "dev",
    "ignoredRules": [
      "EXTERNAL_MISMATCH",
      "UNSORTED_DEPENDENCIES"
    ]
  }
}
