{
  "name": "microcoach_v2",
  "version": "0.1.0",
  "private": true,
  "resolutions": {
    "styled-components": "^5",
    "@mui/styled-engine": "npm:@mui/styled-engine-sc@9.0.0",
    "@types/react": "~18.2.0",
    "@types/react-dom": "~18.2.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.7",
    "@mui/material": "^5.16.7",
    "@react-oauth/google": "^0.12.1",
    "@react-pdf/renderer": "^4.5.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/styled-components": "^5.1.34",
    "aws-amplify": "^6.8.0",
    "i18next": "^23.16.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "styled-components": "^5.3.9",
    "typescript": "^5.1.3",
    "uuid": "^10.0.0",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:cleanup": "ts-node --project seed/tsconfig.json seed/cleanup.ts",
    "seed:ingest": "ts-node --project seed/tsconfig.json seed/ingest-ppq.ts",
    "seed:upload": "ts-node --project seed/tsconfig.json seed/upload.ts",
    "seed:verify": "ts-node --project seed/tsconfig.json seed/verify.ts",
    "seed:generate": "ts-node --project seed/tsconfig.json seed/generate-next-steps.ts",
    "seed:validate": "ts-node --project seed/tsconfig.json seed/validate-next-steps.ts",
    "seed:post-analyze": "APPSYNC_SECRET_NAME=microcoach ts-node --project seed/tsconfig.json seed/post-analyze.ts",
    "sync-prompt-config": "node scripts/sync-prompt-config.mjs"
  },
  "prettier": {
    "singleQuote": true
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "airbnb",
      "airbnb/hooks",
      "airbnb-typescript",
      "prettier",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/typescript"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "project": "./tsconfig.eslint.json"
    },
    "plugins": [
      "react",
      "@typescript-eslint",
      "prettier"
    ],
    "ignorePatterns": [
      "build/*",
      "**/coverage/**",
      "node_modules/*",
      "src/api/**",
      "seed/**",
      "scripts/**",
      "amplify/**"
    ],
    "settings": {
      "import/core-modules": [
        "aws-amplify",
        "@react-oauth/google"
      ]
    },
    "rules": {
      "import/no-extraneous-dependencies": [
        "error",
        {
          "peerDependencies": true
        }
      ],
      "react/jsx-props-no-spreading": [
        "off"
      ],
      "react/require-default-props": [
        "off"
      ],
      "arrow-body-style": [
        "off"
      ],
      "no-console": [
        1,
        {
          "allow": [
            "debug",
            "error"
          ]
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1002.0",
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "mammoth": "^1.11.0",
    "openai": "^4.0.0",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "xlsx": "^0.18.5"
  }
}
